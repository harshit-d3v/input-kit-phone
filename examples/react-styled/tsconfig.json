{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@input-kit/phone": ["../../src/index.ts"],
      "@input-kit/phone/flags": ["../../src/flags.tsx"],
      "@input-kit/phone/validation": ["../../src/validation.ts"]
    }
  },
  "include": ["src"]
}
